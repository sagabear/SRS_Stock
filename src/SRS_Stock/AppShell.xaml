<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="SRS_Stock.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:SRS_Stock.Localization"
    Title="{loc:Translate AppTitle}"
    FlyoutBehavior="Flyout"
    FlyoutWidth="280"
    NavBarHasShadow="False"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
    ForegroundColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
    TitleColor="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}"
    DisabledColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
    UnselectedColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}">

    <Shell.FlyoutHeader>
        <VerticalStackLayout
            Padding="20,28,20,8"
            Spacing="12"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Label
                Text="{loc:Translate AppTitle}"
                Style="{StaticResource DisplayTitle}"
                LineBreakMode="TailTruncation" />
            <BoxView
                HeightRequest="1"
                HorizontalOptions="Fill"
                Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <VerticalStackLayout
            x:Name="FlyoutVersion"
            Padding="20,8,20,16"
            Spacing="12"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <BoxView
                HeightRequest="1"
                HorizontalOptions="Fill"
                Color="{AppThemeBinding Light={StaticResource LineLight}, Dark={StaticResource LineDark}}" />
            <HorizontalStackLayout Spacing="6">
                <Label Text="{loc:Translate AboutVersion}" Style="{StaticResource Caption}" />
                <Label x:Name="VersionLabel" Style="{StaticResource Caption}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>
