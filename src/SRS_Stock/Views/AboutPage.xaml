<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SRS_Stock.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:SRS_Stock.Localization"
    xmlns:views="clr-namespace:SRS_Stock.Views"
    Title="{loc:Translate MenuAbout}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <views:PageHeader
            Padding="{StaticResource HeaderPadding}"
            Title="{loc:Translate MenuAbout}" />

        <ScrollView Grid.Row="1" HorizontalScrollBarVisibility="Never">
            <Border
                Margin="{StaticResource PagePadding}"
                Style="{StaticResource ProductCard}"
                MaximumWidthRequest="{StaticResource FormWidth}"
                HorizontalOptions="Fill"
                VerticalOptions="Start">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{loc:Translate AppTitle}" Style="{StaticResource ProductName}" />
                    <Label Text="{loc:Translate AboutSummary}" LineBreakMode="WordWrap" />
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="{loc:Translate AboutVersion}" Style="{StaticResource Caption}" />
                        <Label Text="{Binding Version}" Style="{StaticResource Caption}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
