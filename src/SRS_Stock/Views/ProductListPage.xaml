<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SRS_Stock.Views.ProductListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:SRS_Stock.Localization"
    xmlns:views="clr-namespace:SRS_Stock.Views"
    x:Name="PageRoot"
    Title="{loc:Translate AppTitle}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <views:PageHeader
            Padding="{StaticResource HeaderPadding}"
            Title="{loc:Translate AppTitle}">
            <views:PageHeader.Trailing>
                <Button
                    Text="{loc:Translate AddProduct}"
                    Style="{StaticResource HeaderButton}"
                    Command="{Binding BindingContext.AddProductCommand, Source={x:Reference PageRoot}}"
                    HorizontalOptions="End" />
            </views:PageHeader.Trailing>
        </views:PageHeader>

        <Grid
            Grid.Row="1"
            Padding="{StaticResource PagePadding}"
            RowDefinitions="Auto,*"
            MaximumWidthRequest="{StaticResource ContentWidth}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">

        <VerticalStackLayout Spacing="12">
            <Border
                Style="{StaticResource ProductCard}"
                Padding="14,12"
                IsVisible="{Binding HasLoaded}">
                <Label
                    Text="{Binding SummaryText}"
                    LineBreakMode="WordWrap" />
            </Border>

            <Border Style="{StaticResource FieldBorder}">
                <Entry
                    Placeholder="{loc:Translate SearchPlaceholder}"
                    Text="{Binding SearchText}"
                    ClearButtonVisibility="WhileEditing"
                    ReturnType="Search" />
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Switch
                    IsToggled="{Binding MissingOnly}"
                    OnColor="{StaticResource Accent}"
                    VerticalOptions="Center" />
                <Label
                    Text="{loc:Translate MissingOnly}"
                    VerticalOptions="Center"
                    LineBreakMode="TailTruncation" />
            </HorizontalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="{loc:Translate SortLabel}" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource FieldBorder}">
                    <Picker
                        ItemsSource="{Binding SortOptions}"
                        ItemDisplayBinding="{Binding Name}"
                        SelectedItem="{Binding SelectedSort}" />
                </Border>
            </VerticalStackLayout>

            <Border
                Style="{StaticResource ErrorBanner}"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmpty}}">
                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorText}" />
            </Border>
        </VerticalStackLayout>

        <RefreshView
            Grid.Row="1"
            Command="{Binding LoadCommand}"
            IsRefreshing="{Binding IsBusy, Mode=OneWay}">
            <CollectionView
                ItemsSource="{Binding Products}"
                SelectionMode="None"
                ItemSizingStrategy="MeasureAllItems"
                ItemsUpdatingScrollMode="KeepScrollOffset">
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Padding="0,48,0,0"
                        Spacing="8"
                        BindingContext="{Binding BindingContext, Source={x:Reference PageRoot}}">
                        <Label
                            Text="{Binding EmptyMessage}"
                            Style="{StaticResource Caption}"
                            HorizontalTextAlignment="Center"
                            IsVisible="{Binding IsEmpty}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="{StaticResource ListItemSpacing}" HorizontalOptions="Fill">
                        <Border Style="{StaticResource ProductCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.OpenProductCommand, Source={x:Reference PageRoot}}"
                                    CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>
                            <Border.Triggers>
                                <DataTrigger
                                    TargetType="Border"
                                    Binding="{Binding Quantity, Converter={StaticResource IsZero}}"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OutOfStockBackgroundLight}, Dark={StaticResource OutOfStockBackgroundDark}}" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource OutOfStockLineLight}, Dark={StaticResource OutOfStockLineDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                <Grid Grid.Row="0" Grid.Column="0">
                                    <Label
                                        Text="{Binding Name}"
                                        Style="{StaticResource ProductName}"
                                        VerticalOptions="Center" />
                                </Grid>
                                <Border
                                    Grid.Column="1"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Style="{StaticResource QuantityPill}">
                                    <Border.Triggers>
                                        <DataTrigger
                                            TargetType="Border"
                                            Binding="{Binding Quantity, Converter={StaticResource IsZero}}"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource OutOfStockBackgroundLight}, Dark={StaticResource OutOfStockBackgroundDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        Text="{Binding Quantity, StringFormat='{0:0.##}'}"
                                        Style="{StaticResource QuantityText}">
                                        <Label.Triggers>
                                            <DataTrigger
                                                TargetType="Label"
                                                Binding="{Binding Quantity, Converter={StaticResource IsZero}}"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource OutOfStockInkLight}, Dark={StaticResource OutOfStockInkDark}}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                                <Grid Grid.Row="1" Grid.Column="0">
                                    <Label
                                        Text="{Binding Barcode}"
                                        Style="{StaticResource Caption}"
                                        LineBreakMode="TailTruncation" />
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="0">
                                    <Label Style="{StaticResource Caption}" LineBreakMode="TailTruncation">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Price, StringFormat='{0:N2}'}" />
                                                <Span Text=" " />
                                                <Span Text="{loc:Translate CurrencySuffix}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                                <Label
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="{loc:Translate OutOfStock}"
                                    Style="{StaticResource OutOfStockCaption}"
                                    IsVisible="{Binding Quantity, Converter={StaticResource IsZero}}" />
                            </Grid>
                        </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
